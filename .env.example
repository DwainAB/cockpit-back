# Port HTTP de l'API
PORT=4000
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGIN=http://localhost:5173
# Base PostgreSQL du cockpit (agents, dossiers de production, tâches, profils des restaurants…)
COCKPIT_DATABASE_URL=postgresql://localhost:5432/cockpit

# --- Agents IA ---
# Les modèles de chaque agent (tâches et conversations) se règlent dans le cockpit, page Agents ;
# les valeurs par défaut de chaque spécialité sont dans src/core/specialties.ts.
# Clé API Claude (agents réglés sur Claude)
ANTHROPIC_API_KEY=
# Clé API OpenRouter (agents réglés sur OpenRouter)
OPENROUTER_API_KEY=

# Modèle d'images des posts réseaux sociaux (OpenRouter, payant : crédits OpenRouter nécessaires)
# IMAGE_MODEL=google/gemini-3.1-flash-image

# --- Génération du design (agent webdesign) ---
# ai | simulated (par défaut : ai si une clé API est présente, sinon simulée)
# DESIGN_GENERATOR=ai
# Effort : low | medium | high | xhigh | max
DESIGN_EFFORT=high

# --- Plateforme Yumco (boutons Commander et Réserver) ---
PLATFORM_BASE_URL=https://platform.yumco.fr
# Restaurant actif utilisé pour les tests (deviendra propre à chaque restaurant)
PLATFORM_RESTAURANT_ID=yumco-restaurant-6

# --- Développement du site (agent développeur, Next.js) ---
# Effort de raisonnement : low | medium | high | xhigh | max
DEV_EFFORT=high
# Tentatives : premier développement + corrections automatiques après tests
DEV_MAX_ATTEMPTS=3
# Port du serveur d'aperçu des sites (origine séparée du cockpit)
PREVIEW_PORT=4100

# --- Mise en ligne (site validé → GitHub → Vercel) ---
# Jeton GitHub (fine-grained) : droits Administration + Contents en écriture sur le compte/organisation ci-dessous
GITHUB_TOKEN=
# Organisation ou compte GitHub qui reçoit un dépôt public par restaurant
GITHUB_OWNER=
# Jeton Vercel (Account Settings → Tokens)
VERCEL_TOKEN=
# Identifiant de l'équipe Vercel (facultatif)
VERCEL_TEAM_ID=

# --- Base Yumco (PostgreSQL, Railway) : restaurants inscrits, lue seulement ---
YUMCO_DATABASE_URL=
# Relecture des restaurants (ms)
RESTAURANTS_REFRESH_MS=60000

# --- API Yumco (back-yumco-node) ---
# Création du restaurant à l'envoi du questionnaire, liens de questionnaire, e-mail d'accès du gérant.
YUMCO_API_URL=https://yumco-back-production.up.railway.app
# Même valeur que COCKPIT_API_KEY dans les variables Railway de l'API. Vide : aucun restaurant créé (mode test).
YUMCO_API_KEY=
# Compte admin Yumco utilisé par le cockpit pour gérer les restaurants (carte, utilisateurs, commandes)
YUMCO_ADMIN_EMAIL=
YUMCO_ADMIN_PASSWORD=
# Récupération des questionnaires remplis depuis un lien (ms)
IMPORT_INTERVAL_MS=60000
