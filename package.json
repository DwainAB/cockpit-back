{
  "name": "@cockpit/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Node.js du cockpit : données en mémoire persistées en JSON, REST + événements SSE.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "cors": "2.8.5",
    "dayjs": "1.11.23",
    "express": "4.21.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
